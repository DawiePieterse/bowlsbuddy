<?php

$date = $this->date;
$title = sprintf('%s - %s', $this->option('client.name.full'), $this->dateFormat($date, IntlDateFormatter::FULL));

$names = $this->calendarBookingNames();

?>
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title><?= $this->escapeHtml($title) ?></title>
    <style>
        @page { size: A4; margin: 15mm; }
        * { box-sizing: border-box; }
        body { margin: 0; padding: 24px; font-family: -apple-system, "Segoe UI", Roboto, Helvetica, Arial, sans-serif; color: #1d1d1f; background: #FFF; font-size: 13px; }
        .sheet { max-width: 800px; margin: 0 auto; }
        .actions { display: flex; gap: 8px; justify-content: center; margin-bottom: 24px; }
        .actions a, .actions button { font: inherit; font-size: 14px; padding: 10px 20px; border-radius: 8px; border: 1px solid #d2d2d7; background: #FFF; color: #1d1d1f; text-decoration: none; cursor: pointer; }
        .actions button { background: #0071e3; border-color: #0071e3; color: #FFF; font-weight: 600; }
        header { display: flex; justify-content: space-between; align-items: flex-end; gap: 16px; border-bottom: 2px solid #1d1d1f; padding-bottom: 10px; margin-bottom: 18px; }
        .qr { text-align: center; flex-shrink: 0; }
        #qr-code svg { display: block; width: 110px; height: 110px; }
        .qr-caption { font-size: 10px; color: #6e6e73; margin-top: 4px; }
        header .club { font-size: 13px; color: #6e6e73; text-transform: uppercase; letter-spacing: 1px; }
        header h1 { margin: 4px 0 0; font-size: 24px; }
        h2 { font-size: 17px; margin: 22px 0 8px; }
        table { width: 100%; border-collapse: collapse; table-layout: fixed; }
        th, td { border: 1px solid #c7c7cc; padding: 8px 10px; text-align: left; vertical-align: top; }
        th.rink { width: 64px; }
        td { height: 44px; }
        .player { overflow-wrap: anywhere; }
        td.closed-cell { background: repeating-linear-gradient(135deg, #FFF, #FFF 6px, #f2f2f7 6px, #f2f2f7 12px); -webkit-print-color-adjust: exact; print-color-adjust: exact; }
        .legend { margin-top: 14px; color: #6e6e73; font-size: 11px; }
        th { background: #f2f2f7; font-size: 12px; text-transform: uppercase; letter-spacing: 0.5px; }
        td.rink { font-weight: 700; }
        td.event, div.event { color: #8e3fb8; font-weight: 600; }
        .closed { border: 2px solid #d70015; color: #d70015; font-weight: 700; padding: 10px 12px; border-radius: 6px; margin-bottom: 8px; }
        footer { margin-top: 28px; color: #8e8e93; font-size: 11px; text-align: right; }
        @media print {
            body { padding: 0; }
            .actions { display: none; }
            section { break-inside: avoid; }
            th { -webkit-print-color-adjust: exact; print-color-adjust: exact; }
        }
    </style>
</head>
<body>
<div class="sheet">

    <div class="actions">
        <a href="<?= $this->url('frontend') ?>"><?= $this->t('Back') ?></a>
        <button type="button" onclick="window.print()"><?= $this->t('Print or save as PDF') ?></button>
    </div>

    <header>
        <div>
            <div class="club"><?= $this->escapeHtml($this->option('client.name.full')) ?> &middot; <?= $this->t('Rink bookings') ?></div>
            <h1><?= $this->escapeHtml($this->dateFormat($date, IntlDateFormatter::FULL)) ?></h1>
        </div>

        <div class="qr">
            <div id="qr-code" data-path="<?= $this->escapeHtmlAttr($this->url('frontend')) ?>"></div>
            <div class="qr-caption"><?= $this->t('Scan for live bookings') ?></div>
        </div>
    </header>

    <?php foreach ($this->greens as $green => $squares): ?>
        <?php $closed = $this->closed[$green]; ?>
        <section>
            <h2><?= $this->escapeHtml(sprintf($this->t('Green %s'), $green)) ?></h2>

            <?php if ($closed): ?>
                <div class="closed"><?= $this->escapeHtml(sprintf($this->t('CLOSED - Green %s is closed on this day'), $green)) ?></div>
            <?php endif; ?>

            <?php

            $slots = $this->sheet[$green]['slots'];
            $rows = $this->sheet[$green]['rows'];
            $hasBookings = false;

            foreach ($rows as $cells) {
                foreach ($cells as $cell) {
                    $hasBookings = $hasBookings || $cell['bookings'];
                }
            }

            ?>
            <?php if ($slots && (! $closed || $hasBookings)): ?>
                <table>
                    <tr>
                        <th class="rink"><?= $this->t('Rink') ?></th>
                        <?php foreach ($slots as list($slotStart, $slotEnd)): ?>
                            <th><?= sprintf('%s - %s', gmdate('H:i', $slotStart), gmdate('H:i', $slotEnd)) ?></th>
                        <?php endforeach; ?>
                    </tr>
                    <?php foreach ($squares as $sid => $square): ?>
                        <tr>
                            <td class="rink"><?= $this->escapeHtml($square->need('name')) ?></td>
                            <?php foreach ($rows[$sid] as $cell): ?>
                                <?php if ($cell['events'] && ! $cell['bookings']): ?>
                                    <td class="event"><?= $this->escapeHtml(implode(', ', $cell['events'])) ?></td>
                                <?php elseif ($cell['bookings']): ?>
                                    <td>
                                        <?php foreach ($cell['bookings'] as $booking): ?>
                                            <?php foreach ($names->names($booking) as $player): ?>
                                                <div class="player"><?= $this->escapeHtml($player) ?></div>
                                            <?php endforeach; ?>
                                        <?php endforeach; ?>
                                        <?php if ($cell['events']): ?>
                                            <div class="event"><?= $this->escapeHtml(implode(', ', $cell['events'])) ?></div>
                                        <?php endif; ?>
                                    </td>
                                <?php else: ?>
                                    <td class="<?= $closed ? 'closed-cell' : 'free' ?>"></td>
                                <?php endif; ?>
                            <?php endforeach; ?>
                        </tr>
                    <?php endforeach; ?>
                </table>
            <?php endif; ?>
        </section>
    <?php endforeach; ?>

    <p class="legend"><?= $this->t('Empty boxes are free - walk-in players can be written in by hand.') ?></p>

    <footer><?= $this->escapeHtml(sprintf($this->t('Printed %s'), $this->dateFormat(new DateTime(), IntlDateFormatter::MEDIUM, IntlDateFormatter::SHORT))) ?></footer>

</div>

<script src="<?= $this->basePath('js/qrcode/qrcode.js') ?>"></script>
<script>
    (function () {
        var container = document.getElementById('qr-code');
        var qr = qrcode(0, 'M');
        qr.addData(new URL(container.getAttribute('data-path'), window.location.href).href);
        qr.make();
        container.innerHTML = qr.createSvgTag({ cellSize: 4, margin: 4 });
    })();
</script>
</body>
</html>
